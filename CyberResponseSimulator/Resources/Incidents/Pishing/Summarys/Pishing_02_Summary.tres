[gd_resource type="Resource" script_class="DailySummary" format=3]
[ext_resource type="Script" path="res://scripts/Incidents/Pishing/DailySummary.gd" id="1"]
[resource]
script = ExtResource("1")
summary_id = "pishing_02"
title = "Jornada de coordinación"
content = "• Recursos Humanos está organizando una actividad interna; habrá mensajes de coordinación durante el día.\n• El contacto habitual de Recursos Humanos es personas@empresa.cl; verifica la dirección completa aunque el nombre mostrado resulte familiar.\n• Las inscripciones y agendas internas se gestionan en intranet.empresa.example, sin enviar contraseñas por correo.\n• Las reservas de salas y las confirmaciones de agenda pueden llegar sin archivos adjuntos.\n• Los pagos excepcionales necesitan una segunda confirmación por un canal conocido.\n• Un tono urgente no reemplaza los procedimientos habituales. Un dominio parecido puede pertenecer a otra organización."
