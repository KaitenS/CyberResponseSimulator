[gd_resource type="Resource" script_class="DailySummary" format=3]
[ext_resource type="Script" path="res://scripts/Incidents/Pishing/DailySummary.gd" id="1"]
[resource]
script = ExtResource("1")
summary_id = "pishing_02"
title = "Jornada de coordinación"
content = "• Recursos Humanos está organizando una actividad interna; habrá mensajes de coordinación durante el día.\n• Las inscripciones internas se gestionan en la intranet, sin volver a solicitar la contraseña por correo.\n• Las reservas de salas y las confirmaciones de agenda pueden llegar sin archivos adjuntos.\n• La empresa mantiene sus dominios habituales; un nombre parecido no garantiza que el mensaje sea interno.\n• Los pagos excepcionales necesitan una segunda confirmación por un canal conocido.\n• Un tono urgente no reemplaza los procedimientos habituales."
