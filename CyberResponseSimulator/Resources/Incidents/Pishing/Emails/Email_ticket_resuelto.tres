recipient = "empleado@empresa.cl"
has_attachment = false
is_phishing = false
explanation = "Es un seguimiento de soporte esperado y deriva al portal habitual sin pedir datos sensibles."

link_text = "Consultar mi ticket"
link_url = "https://soporte.empresa.example/tickets"
