[gd_resource type="Resource" script_class="DailySummary" format=3]
[ext_resource type="Script" path="res://scripts/Incidents/Pishing/DailySummary.gd" id="1"]
[resource]
script = ExtResource("1")
summary_id = "pishing_03"
title = "Jornada de soporte"
content = "• TI anunció una actualización del cliente de soporte: estará disponible en el portal habitual y como cliente_soporte.exe desde la Mesa de ayuda. Puede tardar unos segundos.\n• La dirección habitual de la Mesa de ayuda es soporte@empresa.cl; revisa cada letra del remitente, no solo su nombre visible.\n• El portal habitual es soporte.empresa.example. La autorización de hoy corresponde a cliente_soporte.exe; no se anunciaron otros instaladores por correo.\n• Soporte puede confirmar el estado de un ticket, pero no necesita conocer tu contraseña.\n• Las consultas de proveedores deben relacionarse con solicitudes que ya estaban en curso.\n• Antes de compartir información, compara el destino real del enlace con el portal habitual. El formato del archivo también aporta contexto."
