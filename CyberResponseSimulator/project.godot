; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CyberResponseSimulator"
run/main_scene="uid://d27tv35lywpqr"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

GameManager="*res://scripts/Managers/GameManager.gd"
IncidentManager="*res://scripts/Managers/IncidentManager.gd"
AudioDDoS="*res://scripts/Incidents/DDOS/audio_ddos.gd"
IncidenteDDoS="*res://scripts/Incidents/DDOS/incidente_ddos.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[file_customization]

folder_colors={
"res://assets/": "purple",
"res://assets/CyberDesk/": "purple",
"res://resources/": "green",
"res://resources/Incidents/": "green",
"res://resources/Incidents/Pishing/": "green",
"res://scenes/": "orange",
"res://scenes/Incidents/Pishing/": "orange",
"res://scenes/Menu/": "purple",
"res://scripts/": "yellow",
"res://scripts/Data/": "yellow",
"res://scripts/Game/": "yellow",
"res://scripts/Incidents/": "yellow",
"res://scripts/Incidents/Pishing/": "yellow",
"res://scripts/Managers/": "yellow",
"res://scripts/Menu/": "purple",
"res://shaders/": "red",
"res://ui/": "pink"
}

