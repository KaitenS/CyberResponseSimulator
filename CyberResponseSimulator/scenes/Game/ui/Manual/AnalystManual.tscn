[node name="PhishingPage" type="VBoxContainer" parent="Overlay/Center/Book/ChapterScroll/Pages"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12
[node name="Title" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/PhishingPage"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Phishing"
autowrap_mode = 3
mouse_filter = 2
[node name="DefinitionTitle" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/PhishingPage"]
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "¿QUÉ ES?"
autowrap_mode = 3
mouse_filter = 2
[node name="Definition" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/PhishingPage"]
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "Es un engaño que suplanta a una persona u organización para obtener datos, dinero o lograr que abras contenido peligroso."
autowrap_mode = 3
mouse_filter = 2
[node name="SignalsTitle" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/PhishingPage"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "SEÑALES DE ALERTA"
autowrap_mode = 3
mouse_filter = 2
[node name="Signals" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/PhishingPage"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "• Solicitudes de contraseñas o pagos inesperados.\n• Dominios parecidos, pero distintos del habitual.\n• Adjuntos o enlaces que no esperabas.\n• Presión para actuar sin comprobar.\n• Contradicciones con las actividades del día."
autowrap_mode = 3
mouse_filter = 2
[node name="ActionsTitle" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/PhishingPage"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "CÓMO INVESTIGAR"
autowrap_mode = 3
mouse_filter = 2
[node name="Actions" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/PhishingPage"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "1. Consulta el resumen diario.\n2. Lee la dirección completa y lo que se solicita.\n3. Contrasta el formato del adjunto y el contexto.\n4. Verifica por un canal conocido antes de confiar."
autowrap_mode = 3
mouse_filter = 2
[node name="Note" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/PhishingPage"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "Un mensaje bien escrito o una dirección familiar no garantizan que sea seguro."
autowrap_mode = 3
mouse_filter = 2

[node name="MalwarePage" type="VBoxContainer" parent="Overlay/Center/Book/ChapterScroll/Pages"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12
visible = false
[node name="Title" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/MalwarePage"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Malware"
autowrap_mode = 3
mouse_filter = 2
[node name="DefinitionTitle" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/MalwarePage"]
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "¿QUÉ ES?"
autowrap_mode = 3
mouse_filter = 2
[node name="Definition" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/MalwarePage"]
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "Es software malicioso que puede alterar un equipo, robar información, cifrar archivos o permitir accesos no autorizados."
autowrap_mode = 3
mouse_filter = 2
[node name="SignalsTitle" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/MalwarePage"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "SEÑALES DE ALERTA"
autowrap_mode = 3
mouse_filter = 2
[node name="Signals" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/MalwarePage"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "• Procesos o archivos que no reconoces.\n• Comportamientos fuera de lo habitual.\n• Consumo de recursos sin explicación.\n• Cambios inesperados o alertas de seguridad."
autowrap_mode = 3
mouse_filter = 2
[node name="ActionsTitle" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/MalwarePage"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "CÓMO INVESTIGAR"
autowrap_mode = 3
mouse_filter = 2
[node name="Actions" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/MalwarePage"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "1. Revisa los procesos y archivos disponibles.\n2. Reúne evidencias antes de actuar.\n3. Distingue lo legítimo de lo sospechoso.\n4. Evalúa la contención según la información reunida."
autowrap_mode = 3
mouse_filter = 2
[node name="Note" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/MalwarePage"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "Un nombre extraño o un uso elevado de CPU no bastan para confirmar malware. No elimines archivos a ciegas."
autowrap_mode = 3
mouse_filter = 2

[node name="DDoSPage" type="VBoxContainer" parent="Overlay/Center/Book/ChapterScroll/Pages"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12
visible = false
[node name="Title" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/DDoSPage"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "DDoS"
autowrap_mode = 3
mouse_filter = 2
[node name="DefinitionTitle" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/DDoSPage"]
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "¿QUÉ ES?"
autowrap_mode = 3
mouse_filter = 2
[node name="Definition" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/DDoSPage"]
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "Un ataque distribuido de denegación de servicio busca saturar un sistema con tráfico desde múltiples orígenes, dificultando el acceso a usuarios legítimos."
autowrap_mode = 3
mouse_filter = 2
[node name="SignalsTitle" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/DDoSPage"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "SEÑALES DE ALERTA"
autowrap_mode = 3
mouse_filter = 2
[node name="Signals" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/DDoSPage"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "• Aumento inusual de solicitudes.\n• Lentitud, errores o pérdida de disponibilidad.\n• Recursos saturados en uno o varios servidores.\n• Patrones de tráfico diferentes de los habituales."
autowrap_mode = 3
mouse_filter = 2
[node name="ActionsTitle" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/DDoSPage"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "CÓMO INVESTIGAR"
autowrap_mode = 3
mouse_filter = 2
[node name="Actions" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/DDoSPage"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "1. Observa las métricas y el estado de los servidores.\n2. Contrasta la demanda con el funcionamiento habitual.\n3. Evalúa la mitigación disponible y sus efectos.\n4. Comprueba que el servicio se recupere para usuarios legítimos."
autowrap_mode = 3
mouse_filter = 2
[node name="Note" type="Label" parent="Overlay/Center/Book/ChapterScroll/Pages/DDoSPage"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "Una caída no demuestra por sí sola un ataque. Un bloqueo excesivo también puede interrumpir tráfico legítimo."
autowrap_mode = 3
mouse_filter = 2

