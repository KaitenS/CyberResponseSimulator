[resource]
script = ExtResource("1_pxxuf")
summary_id = "pishing_01"
title = "Cierre de período"
content = "• Finanzas está cerrando el período; es habitual que circulen reportes entre las áreas.\n• El contacto habitual de Finanzas es María González: maria.gonzalez@empresa.cl. Compara la dirección completa, no solo el nombre visible.\n• Los reportes se consultan en finanzas.empresa.example y se comparten en formatos de lectura, no como instaladores.\n• Hay personal ausente esta semana; algunas solicitudes poco habituales podrían necesitar confirmación.\n• Las reuniones de equipo mantienen sus horarios habituales.\n• TI conserva sus canales de distribución de software; hoy no hay una campaña de actualización anunciada.\n• Una dirección familiar no basta para confiar: las peticiones sensibles deben seguir los procedimientos internos."
metadata/_custom_type_script = "uid://bmp4j51dulpll"
